# ============================================================
# IDRA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# ----- Database ------------------------------------------------
# Local dev default (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./foid.db

# Production (PostgreSQL — uncomment and fill in your Supabase/Neon/Railway URL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ----- JWT Auth ------------------------------------------------
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Groq (AI Ledger + Chat) ---------------------------------
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ----- Mono Open Banking ---------------------------------------
# Get from https://app.mono.co/apps — use sandbox keys for dev
MONO_PUBLIC_KEY=test_pk_...
MONO_SECRET_KEY=test_sk_...

# ----- Paystack (Credit Purchases) ----------------------------
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_...

# ----- CORS ----------------------------------------------------
# Comma-separated list of allowed origins (no trailing slashes, no spaces)
# Production example: ALLOWED_ORIGINS=https://yourapp.vercel.app,https://www.yourapp.com
ALLOWED_ORIGINS=http://localhost:5173

# ----- Redis (Optional) ----------------------------------------
# Leave blank to disable caching (app starts fine without it)
REDIS_URL=

# ----- Environment ---------------------------------------------
# Set to "production" on your deployment host — disables auto create_all (Alembic handles schema)
ENV=development
